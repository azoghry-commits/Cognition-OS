{
  "version": "0.5.0",
  "default_mode": "AUTO",
  "modes": {
    "AUTO": {
      "frameworks": 4,
      "rebuttal_rounds": 1
    },
    "QUICK": {
      "frameworks": 2,
      "rebuttal_rounds": 0
    },
    "STANDARD": {
      "frameworks": 4,
      "rebuttal_rounds": 1
    },
    "DEEP": {
      "frameworks": 8,
      "rebuttal_rounds": 2
    },
    "EXECUTIVE": {
      "frameworks": 3,
      "rebuttal_rounds": 1
    },
    "CUSTOM": {
      "frameworks": 12,
      "rebuttal_rounds": 2
    },
    "LEARN": {
      "frameworks": 1,
      "rebuttal_rounds": 0
    }
  },
  "token_profiles": {
    "LEAN": {
      "frameworks": 1,
      "references": 1,
      "context_fraction": 0.12
    },
    "BALANCED": {
      "frameworks": 4,
      "references": 3,
      "context_fraction": 0.25
