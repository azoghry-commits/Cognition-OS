{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "kind",
    "framework_id",
    "source",
    "responsibilities"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^AG-(0[1-9]|[1-4][0-9]|5[0-2])$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "framework_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "object"
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
