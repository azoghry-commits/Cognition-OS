{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "specification_version",
    "artifact_type",
    "request_id",
    "status",
    "findings",
    "supporting_evidence",
    "issues",
    "computed_results",
    "recommendations",
    "confidence_limitations",
    "unresolved_questions",
    "follow_up_checks",
    "provenance"
  ],
  "properties": {
    "specification_version": {
      "const": "4.1"
    },
    "artifact_type": {
      "const": "advisory_result"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "COMPLETED",
        "PARTIAL",
        "BLOCKED",
        "FAILED"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "classification",
          "evidence_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "VERIFIED_FACT",
              "SOURCE_SUPPORTED",
              "CALCULATED_RESULT",
              "SIMULATED_RESULT",
              "ASSUMPTION",
              "INFERENCE",
              "HYPOTHESIS",
              "UNKNOWN"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 100
          }
        },
        "additionalProperties": false
      },
      "maxItems": 50
    },
    "supporting_evidence": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "id",
          "kind",
          "locator",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "source",
              "assumption",
              "calculation",
              "simulation",
              "observation"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {},
          "result": {},
          "verification": {
            "type": "object",
            "required": [
              "status",
              "checked_at"
            ],
            "properties": {
              "status": {
                "enum": [
                  "VERIFIED",
                  "UNVERIFIED"
                ]
              },
              "checked_at": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 100
    },
    "computed_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "operation",
          "inputs",
          "method",
          "result",
          "unit",
          "evidence_ids"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "object"
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "result": {},
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 100
          }
        },
        "additionalProperties": false
      },
      "maxItems": 50
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 100
    },
    "confidence_limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 100
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 100
    },
    "follow_up_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 100
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "origin_classification",
          "agent_id",
          "trace_id"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "origin_classification": {
            "type": "string",
            "minLength": 1
          },
          "agent_id": {
            "type": "string",
            "minLength": 1
          },
          "trace_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "maxItems": 50
    }
  },
  "additionalProperties": false
}
