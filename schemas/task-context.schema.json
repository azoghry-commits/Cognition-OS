{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "objective",
    "task_type"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "enum": [
        "simple_edit",
        "translation",
        "formatting",
        "arithmetic",
        "debugging",
        "architecture",
        "strategic_decision",
        "artifact_review",
        "documentation",
        "implementation",
        "learning",
        "other"
      ]
    },
    "risk": {
      "enum": [
        "normal",
        "high",
        "critical",
        "unknown"
      ]
    },
    "complexity": {
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "evidence_sufficiency": {
      "enum": [
        "sufficient",
        "partial",
        "missing",
        "contradictory",
        "unknown"
      ]
    },
    "capabilities": {
      "type": "object",
      "required": [],
      "properties": {
        "skills": {
          "type": "boolean"
        },
        "deterministic_validation": {
          "type": "boolean"
        },
        "deep_advisory": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "augmentation_relevant": {
      "type": "boolean"
    },
    "analysis_sufficient": {
      "type": "boolean"
    },
    "required_validation": {
      "type": "boolean"
    },
    "deep_requested": {
      "type": "boolean"
    },
    "requested_frameworks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^FW-(0[1-9]|[1-4][0-9]|50)$"
      },
      "maxItems": 50,
      "uniqueItems": true
    },
    "completed_frameworks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^FW-(0[1-9]|[1-4][0-9]|50)$"
      },
      "maxItems": 50,
      "uniqueItems": true
    },
    "budget": {
      "type": "object",
      "required": [],
      "properties": {
        "framework_invocations": {
          "type": "integer",
          "minimum": 0
        },
        "subagent_calls": {
          "type": "integer",
          "minimum": 0
        },
        "debate_rounds": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "computation_ms": {
          "type": "integer",
          "minimum": 0
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 100
    },
    "relevant_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 100
    }
  },
  "additionalProperties": false
}
