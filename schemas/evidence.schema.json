{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "kind",
    "locator",
    "content"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "source",
        "assumption",
        "calculation",
        "simulation",
        "observation"
      ]
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_at": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {},
    "result": {},
    "verification": {
      "type": "object",
      "required": [
        "status",
        "checked_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "VERIFIED",
            "UNVERIFIED"
          ]
        },
        "checked_at": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
